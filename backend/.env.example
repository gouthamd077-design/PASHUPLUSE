# Application Environment Configuration
APP_NAME="PASHU PULSE API"
APP_ENV="development"
DEBUG=True

# Database (defaults to local SQLite file for simple Windows dev)
DATABASE_URL="sqlite:///./pashupulse.db"

# Security & Authentication (JWT)
SECRET_KEY="pashupulse-dev-secret-key-change-in-production-only-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Mock OTP in Development
DEV_MOCK_OTP="1234"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
