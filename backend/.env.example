# Application Environment Configuration
APP_NAME="PASHU PULSE API"
APP_ENV="development"
DEBUG=True

# Database Configuration
# Local SQLite fallback:
DATABASE_URL="sqlite:///./pashupulse.db"
# Supabase PostgreSQL (replace with your Supabase DB URL):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase API Configuration
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Security & Authentication (JWT)
SECRET_KEY="pashupulse-dev-secret-key-change-in-production-only-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Mock OTP in Development
DEV_MOCK_OTP="1234"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "*"]
